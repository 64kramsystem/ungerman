{
  "manifest_version": 2,
  "name": "Ungerman",
  "version": "1.1.3",
  "description": "Custom reply subject prefixes by recipient, with AW prefix unstacking for other replies. Forwards are unchanged.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ungerman@64kramsystem.github.io",
      "strict_min_version": "137.0"
    }
  },
  "background": {
    "scripts": ["subject.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "compose",
    "storage"
  ]
}
