{
  "manifest_version": 2,
  "name": "Ungerman",
  "version": "1.1.1",
  "description": "When replying, collapses stacked subject prefixes containing 'AW:' into a single 'AW:' prefix, including mixed chains such as 'AW: Re: Aw: Aw:'.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ungerman@64kramsystem.github.io",
      "strict_min_version": "91.0"
    }
  },
  "background": {
    "scripts": ["subject.js", "background.js"]
  },
  "permissions": [
    "compose"
  ]
}
